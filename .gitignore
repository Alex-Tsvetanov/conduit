# --- LaTeX ---------------------------------------------------------------
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.lof
*.lot

# Изходът на latexmk. Не се версионира, докато отчетът е скелет: PDF-ът се
# променя при всяко сглобяване. Готовият за предаване PDF се добавя изрично
# с git add -f, когато стане окончателен.
docs/build/

# --- C++ и CMake ---------------------------------------------------------
# Закотвено с наклонена черта отпред. Незакотвеното „build/“ би изключило и
# docs/build по същото правило, а изключването на цяла директория не може да се
# отмени за отделен файл в нея: git не включва файл, чиято директория е изключена.
/build/
cmake-build-*/
CMakeUserPresets.json
compile_commands.json
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk

# --- Резултати от измерванията ------------------------------------------
# Суровите изходи на измервателната програма се записват в приложението към
# отчета, а не в репозиторията.
benchmarks/results/

# --- Среда за разработка -------------------------------------------------
.vscode/
.idea/
.cache/
.DS_Store
Thumbs.db

# The built documentation PDF is tracked so the report can be read without a
# LaTeX toolchain. Everything else latexmk produces stays out of git.
!docs/build/Main.pdf
